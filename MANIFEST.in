include LICENSE README.md pyproject.toml setup.py CMakeLists.txt .gitmodules
include requirements/ascend.txt requirements/build.txt
include submodule-materials.json
include docs/design/layout-migration.json
include release-profile.json
include docs/p3-native-migration.json docs/p4-retired-native-owners.json
graft lmcache
graft csrc
graft cmake
graft third_party
recursive-include tools check_p4*.py check_npu*.py check_native_layout.py p4_*.py
global-exclude __pycache__ *.pyc *.pyo .git .git/**
prune build
prune dist
prune csrc/build
prune csrc/output
prune third_party/kvcache-ops/.git
prune third_party/kvcache-ops/build
prune third_party/kvcache-ops/output
